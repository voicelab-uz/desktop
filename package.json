{
  "name": "voicelab-desktop",
  "version": "1.2.1",
  "description": "VoiceLab Desktop — account-based cloud dictation powered by VoiceLab",
  "desktopName": "voicelab.desktop",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js && node scripts/build-macos-paste-addon.js",
    "compile:winkeys": "node scripts/build-windows-key-listener.js",
    "compile:linuxkeys": "node scripts/build-linux-key-listener.js",
    "compile:text-monitor": "node scripts/build-text-monitor.js",
    "compile:winpaste": "node scripts/build-windows-fast-paste.js",
    "compile:linux-paste": "node scripts/build-linux-fast-paste.js",
    "compile:linux-system-audio": "node scripts/build-linux-system-audio.js",
    "compile:media-remote": "node scripts/build-media-remote.js",
    "compile:mediaremote-adapter": "node scripts/build-mediaremote-adapter.js",
    "compile:mic-listener": "node scripts/build-macos-mic-listener.js",
    "compile:audio-tap": "node scripts/build-macos-audio-tap.js",
    "compile:native": "npm run compile:globe && npm run compile:fast-paste && npm run compile:winkeys && npm run compile:linuxkeys && npm run compile:winpaste && npm run compile:linux-paste && npm run compile:linux-system-audio && npm run compile:text-monitor && npm run compile:media-remote && npm run compile:mediaremote-adapter && npm run compile:mic-listener && npm run compile:audio-tap",
    "prestart": "npm run compile:native",
    "start": "electron .",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:test-update": "cross-env VOICELAB_TEST_UPDATE_NOTIFICATION=1 npm run dev",
    "predev:main": "npm run generate:preloads && npm run compile:native",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prebuild": "npm run generate:preloads && npm run compile:native",
    "build": "cd src && vite build && cd .. && electron-builder",
    "build:staging": "npm run build:renderer && electron-builder --config electron-builder.staging.json",
    "build:development": "npm run build:renderer && electron-builder --config electron-builder.development.json",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "compile:mac-icon": "node scripts/compile-macos-icon.js",
    "prebuild:mac": "npm run compile:native && npm run compile:mac-icon",
    "prebuild:mac:arm64": "npm run prebuild:mac",
    "prebuild:mac:x64": "npm run prebuild:mac",
    "build:mac": "npm run build:renderer && electron-builder --mac -c.mac.forceCodeSigning=true",
    "build:mac:arm64": "npm run build:renderer && electron-builder --mac --arm64 -c.mac.forceCodeSigning=true",
    "build:mac:signed": "npm run prebuild:mac && npm run build:renderer && electron-builder --mac -c.mac.forceCodeSigning=true",
    "build:mac:unsigned": "npm run prebuild:mac && npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "build:mac:cloud": "npm run prebuild:mac && npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "build:mac:x64": "npm run build:renderer && electron-builder --mac --x64 -c.mac.forceCodeSigning=true",
    "verify:mac-signature": "node scripts/verify-macos-signature.js",
    "prebuild:win": "npm run compile:native && npm run download:meeting-aec-helper && npm run download:nircmd && npm run download:windows-fast-paste && npm run download:windows-key-listener && npm run download:windows-mic-listener && npm run download:windows-system-audio-helper",
    "build:win": "npm run build:renderer && electron-builder --win",
    "prebuild:linux": "npm run compile:native && npm run download:meeting-aec-helper",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:linux:appimage": "npm run build:renderer && electron-builder --linux AppImage",
    "build:linux:deb": "npm run build:renderer && electron-builder --linux deb",
    "build:linux:rpm": "npm run build:renderer && electron-builder --linux rpm",
    "build:linux:tar": "npm run build:renderer && electron-builder --linux tar.gz",
    "prepack": "npm run generate:preloads && npm run compile:native",
    "pack": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "predist": "npm run generate:preloads && npm run compile:native",
    "dist": "npm run build:renderer && electron-builder",
    "download:nircmd": "node scripts/download-nircmd.js",
    "download:windows-fast-paste": "node scripts/download-windows-fast-paste.js",
    "download:windows-key-listener": "node scripts/download-windows-key-listener.js",
    "download:windows-mic-listener": "node scripts/download-windows-mic-listener.js",
    "download:windows-system-audio-helper": "node scripts/download-windows-system-audio-helper.js",
    "download:meeting-aec-helper": "node scripts/download-meeting-aec-helper.js --current",
    "download:meeting-aec-helper:all": "node scripts/download-meeting-aec-helper.js --all",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:release-contract": "node --test test/helpers/releaseWorkflow.test.js test/helpers/packagedPreloads.test.js",
    "typecheck": "cd src && tsc --noEmit",
    "quality-check": "npm run format:check && npm run typecheck",
    "i18n:check": "node scripts/check-i18n.js",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js",
    "generate:preloads": "node scripts/generate-preloads.js"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "cloud-dictation",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "Voicelab",
    "email": "info@voicelab.uz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voicelab-uz/desktop.git"
  },
  "homepage": "https://voicelab.uz",
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.4.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "17.5.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.10",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@homebridge/dbus-native": "^0.7.7",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tanstack/react-virtual": "^3.13.2",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-placeholder": "3.22.5",
    "@tiptap/extension-task-item": "3.22.5",
    "@tiptap/extension-task-list": "3.22.5",
    "@tiptap/react": "3.22.5",
    "@tiptap/starter-kit": "3.22.5",
    "better-sqlite3": "12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "electron-updater": "^6.6.2",
    "i18next": "^26.3.6",
    "kysely": "^0.28.17",
    "lucide-react": "^1.7.0",
    "onnxruntime-node": "^1.21.0",
    "ps-list": "^9.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.22",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.3.4",
    "unbzip2-stream": "^1.4.3",
    "unzipper": "^0.12.3",
    "ws": "8.21.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "@electron/fuses": "2.1.3",
    "adm-zip": "^0.6.0",
    "@tiptap/extension-blockquote": "3.22.5",
    "@tiptap/extension-bold": "3.22.5",
    "@tiptap/extension-bubble-menu": "3.22.5",
    "@tiptap/extension-bullet-list": "3.22.5",
    "@tiptap/extension-code": "3.22.5",
    "@tiptap/extension-code-block": "3.22.5",
    "@tiptap/extension-document": "3.22.5",
    "@tiptap/extension-dropcursor": "3.22.5",
    "@tiptap/extension-floating-menu": "3.22.5",
    "@tiptap/extension-gapcursor": "3.22.5",
    "@tiptap/extension-hard-break": "3.22.5",
    "@tiptap/extension-heading": "3.22.5",
    "@tiptap/extension-horizontal-rule": "3.22.5",
    "@tiptap/extension-italic": "3.22.5",
    "@tiptap/extension-link": "3.22.5",
    "@tiptap/extension-list": "3.22.5",
    "@tiptap/extension-list-item": "3.22.5",
    "@tiptap/extension-list-keymap": "3.22.5",
    "@tiptap/extension-ordered-list": "3.22.5",
    "@tiptap/extension-paragraph": "3.22.5",
    "@tiptap/extension-strike": "3.22.5",
    "@tiptap/extension-text": "3.22.5",
    "@tiptap/extension-underline": "3.22.5",
    "@tiptap/extensions": "3.22.5",
    "@tiptap/pm": "3.22.5",
    "@xmldom/xmldom": "0.8.13",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.7.2",
    "ip-address": "10.2.0",
    "js-yaml": "5.3.0",
    "markdown-it": "14.2.0",
    "tmp": "0.2.7"
  }
}
